{
  "name": "kmd",
  "version": "0.3.0",
  "description": "Kawaii MD reader: a local-first desktop Markdown reader with first-class DESIGN.md support.",
  "license": "MIT",
  "author": "kmd contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elevenoutoften/kmd.git"
  },
  "bugs": {
    "url": "https://github.com/elevenoutoften/kmd/issues"
  },
  "homepage": "https://github.com/elevenoutoften/kmd#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons:sync": "node scripts/sync-icons.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:portable": "node scripts/tauri-build.mjs --no-bundle",
    "tauri:bundle:app": "node scripts/tauri-build.mjs --bundles app",
    "test": "vitest run"
  },
  "dependencies": {
    "@axis-love/contracts": "file:../kmd-web/packages/contracts",
    "@axis-love/core": "file:../kmd-web/packages/core",
    "@axis-love/browser": "file:../kmd-web/packages/browser",
    "@axis-love/react": "file:../kmd-web/packages/react",
    "@axis-love/element": "file:../kmd-web/packages/element",
    "@axis-love/styles": "file:../kmd-web/packages/styles",
    "@axis-love/design": "file:../kmd-web/packages/design",
    "@axis-love/highlighting": "file:../kmd-web/packages/highlighting",
    "@axis-love/mermaid": "file:../kmd-web/packages/mermaid",
    "@axis-love/math": "file:../kmd-web/packages/math",
    "@axis-love/kmd-web": "file:../kmd-web/packages/kmd-web",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.45",
    "mermaid": "^11.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.5"
  }
}
